PORT=1200
NODE_ENV=development

# Opcion 1 (recomendada): URL completa
DATABASE_URL=postgres://usuario:password@host:puerto/base_de_datos?sslmode=require

# Opcion 2: variables separadas (usa estas si NO defines DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=bandas
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false

# Ejecuta migraciones automaticamente al iniciar la app
AUTO_MIGRATE=true

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
JWT_ISSUER=conveyor-backend
JWT_AUDIENCE=conveyor-clients
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=600000
ORDER_CRITICAL_RETRY_ATTEMPTS=3
EMQX_ENABLED=false
EMQX_URL=mqtt://localhost:1883
EMQX_USERNAME=
EMQX_PASSWORD=
EMQX_CLIENT_ID=
EMQX_QOS=1
EMQX_ORDERS_CREATE_TOPIC=pedidos/creacion
EMQX_BAND_ALERTS_TOPIC=bandas/alertas
EMQX_BAND_ERROR_RESOLVE_TOPIC=bandas/errores/resolver
MQTT_TOPIC_BANDAS_ALERTAS=bandas/alertas
MQTT_TOPIC_BANDAS_ERROR_RESOLVER=bandas/errores/resolver
SIM_BAND_ERROR_ENABLED=true
SIM_BAND_ERROR_CODE=BANDAS_DETENIDAS
SIM_BAND_ERROR_MESSAGE=Todas las bandas fueron detenidas por una alerta critica.

# Measurement flow
MEASUREMENT_REALTIME_NAMESPACE=/realtime/v1
MEASUREMENT_CRITICAL_RETRY_ATTEMPTS=3
MEASUREMENT_IDEMPOTENCY_MAX_LENGTH=120
MEASUREMENT_IDEMPOTENCY_MIN_LENGTH=6
MEASUREMENT_IDEMPOTENCY_PATTERN=^[a-zA-Z0-9][a-zA-Z0-9-]{5,119}$

# Strangler y deprecacion
ENABLE_V1_API=true
ENABLE_LEGACY_API=true
DEPRECATION_MIN_DAYS=30
DEPRECATION_LEGACY_TRAFFIC_THRESHOLD=5
DEPRECATION_STABLE_DAYS=7

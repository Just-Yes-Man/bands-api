# Opción 1 (recomendada): URL completa
DATABASE_URL=postgres://usuario:password@host:puerto/base_de_datos?sslmode=require

# Opción 2: variables separadas (usa estas si NO defines DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=bandas
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false

# Ejecuta schema.sql automáticamente al iniciar la app
AUTO_MIGRATE=true
